---
interface Props { number: string; title: string; id: string; lead?: string }
const { number, title, id, lead } = Astro.props;
---
<div class="section-heading">
  <h2 id={`${id}-title`}>
    <span class="section-heading__num">{number}<span class="visually-hidden"> · </span></span>{title}
  </h2>
  {lead && <p class="section-heading__lead">{lead}</p>}
</div>

<style>
  .section-heading {
    padding-top: var(--space-4);
    border-top: 1px solid var(--text-primary);
    margin-bottom: var(--space-6);
  }
  h2 {
    font-size: var(--text-h2);
    line-height: 1.06;
    letter-spacing: -0.022em;
  }
  .section-heading__num {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
  }
  .section-heading__lead {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.25;
    font-weight: 500;
    max-width: 24em;
    text-wrap: balance;
  }
</style>
