---
import brain from '../content/brain.json';
// Head, maze and tangle drawn by scripts/brain_sketch.py; the nodes and boxes are built here from brain.json.
import sceneSvg from '../assets/brain/scene.svg?raw';

const staticArt = sceneSvg.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const [vx, vy, vw, vh] = brain.viewBox;
const { boxes } = brain;

/** A soft, slightly lopsided blob around an ellipse, the same every build. */
function blobPath(cx: number, cy: number, rx: number, ry: number, seed: number): string {
  let s = seed * 9301 + 49297;
  const rand = () => ((s = (s * 9301 + 49297) % 233280) / 233280) * 2 - 1;
  const n = 10;
  const pts = Array.from({ length: n }, (_, k) => {
    const t = (k / n) * Math.PI * 2;
    const f = 1 + 0.07 * rand();
    return [cx + rx * f * Math.cos(t), cy + ry * f * Math.sin(t)];
  });
  let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
  for (let i = 0; i < n; i++) {
    const [p0, p1, p2, p3] = [pts[(i - 1 + n) % n], pts[i], pts[(i + 1) % n], pts[(i + 2) % n]];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
  }
  return `${d} Z`;
}

// What the animation script needs to know about the drawing.
const config = JSON.stringify({
  tangle: brain.tangle,
  exit: brain.exit,
  nodes: brain.nodes.map(({ id, x, y, rx, ry }) => ({ id, x, y, rx, ry })),
  boxes,
});
const segW = boxes.w / boxes.segments;
---
<figure class="brain" aria-labelledby="brain-title">
  <svg
    class="brain__svg"
    viewBox={`${vx} ${vy} ${vw} ${vh}`}
    role="img"
    aria-label={`${brain.title}. ${brain.description}`}
    data-config={config}
  >
    <g class="bm-static" fill="none" stroke="#1a3300" stroke-linecap="round" stroke-linejoin="round" set:html={staticArt} />

    <g class="bm-nodes">
      {brain.nodes.map((n, i) => (
        <g class="bm-node" data-node={n.id} style={`--i: ${i}`}>
          <g class="bm-node__float">
            <g class="bm-node__bump">
              <path class="bm-node__shadow" d={blobPath(n.x + 4, n.y + 5, n.rx, n.ry, i + 1)} />
              <path class="bm-node__shape" d={blobPath(n.x, n.y, n.rx, n.ry, i + 1)} fill={n.fill} />
              <text class="bm-node__label" x={n.x} y={n.y + 1}>{n.label}</text>
            </g>
          </g>
        </g>
      ))}
    </g>

    <g class="bm-boxes is-full">
      {boxes.ys.map((y, b) => (
        <g class="bm-box">
          <rect class="bm-box__slot" x={boxes.x} y={y - boxes.h / 2} width={boxes.w} height={boxes.h} rx="3" />
          {Array.from({ length: boxes.segments }, (_, s) => (
            <rect
              class="bm-box__seg is-filled"
              data-box={b}
              data-seg={s}
              x={boxes.x + s * segW}
              y={y - boxes.h / 2}
              width={segW + (s < boxes.segments - 1 ? 0.6 : 0)}
              height={boxes.h}
            />
          ))}
        </g>
      ))}
    </g>

    <g class="bm-blobs" />
  </svg>
  <figcaption id="brain-title" class="brain__title">{brain.title}</figcaption>
</figure>

<style>
  .brain {
    width: 100%;
    max-width: 760px;
    margin: var(--space-8) auto 0;
  }
  .brain__svg { display: block; width: 100%; height: auto; overflow: visible; }
  @media (max-width: 639px) {
    /* Phones: run to the screen edges so the labels stay legible. */
    .brain { width: calc(100% + 2 * var(--gutter)); max-width: none; margin-inline: calc(-1 * var(--gutter)); overflow-x: clip; }
  }

  .brain__title {
    margin-top: var(--space-1);
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    line-height: 1;
    text-align: center;
    transform: rotate(-2deg);
  }

  /* ---------- Static drawing ---------- */
  .brain__svg :global(.bm-head) { stroke-width: 3; }
  .brain__svg :global(.bm-brain) { stroke-width: 2.4; fill: #ffe95c; fill-opacity: 0.16; }
  .brain__svg :global(.bm-maze) { stroke-width: 2; opacity: 0.28; }
  .brain__svg :global(.bm-tangle) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-wiggle 2.6s ease-in-out infinite;
  }
  .brain__svg :global(.bm-q) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-float 3.2s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.8s);
  }

  /* ---------- Nodes: they float, squish when a blob bounces off, and lift on hover ---------- */
  .bm-node {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 260ms cubic-bezier(.3, 1.6, .5, 1);
  }
  .bm-node__float {
    animation: bm-float 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.9s);
  }
  .bm-node__shape {
    stroke: #1a3300;
    stroke-width: 2;
    transition: filter 260ms ease, stroke-width 260ms ease;
  }
  .bm-node__shadow { fill: #1a3300; opacity: 0; transition: opacity 260ms ease; }
  .bm-node__label {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 25px;
    fill: #1a3300;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }
  .bm-node:hover { transform: scale(1.08) rotate(-2deg); }
  .bm-node:hover .bm-node__shape { filter: saturate(1.5) brightness(1.04); stroke-width: 2.6; }
  .bm-node:hover .bm-node__shadow { opacity: 1; }

  /* ---------- Order: three boxes that fill segment by segment ---------- */
  .bm-box__slot { fill: none; stroke: #1a3300; stroke-width: 2; stroke-dasharray: 6 7; opacity: 0.4; }
  .bm-box__seg { fill: #1a3300; opacity: 0; transition: opacity 500ms ease; }
  .bm-box__seg.is-filled { opacity: 1; transition: none; }
  .bm-boxes.is-full .bm-box {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-settle 700ms cubic-bezier(.3, 1.6, .5, 1);
  }
  .bm-boxes.is-full .bm-box:nth-child(2) { animation-delay: 80ms; }
  .bm-boxes.is-full .bm-box:nth-child(1) { animation-delay: 160ms; }


  @keyframes bm-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes bm-wiggle {
    0%, 100% { transform: rotate(-4deg) scale(1); }
    50% { transform: rotate(4deg) scale(1.04); }
  }
  @keyframes bm-settle {
    0% { transform: scaleX(1); }
    40% { transform: scaleX(1.05); }
    100% { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .brain :global(*) { animation: none !important; transition: none !important; }
  }
</style>

<script>
  import '../scripts/pick-my-brain.ts';
</script>
