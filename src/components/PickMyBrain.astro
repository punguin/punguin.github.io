---
import brain from '../content/brain.json';
// Hand-drawn parts generated by scripts/brain_sketch.py from brain.json; inlined so CSS can animate them.
import scene from '../assets/brain/scene.svg?raw';
const art = import.meta.glob<string>('../assets/brain/orb-*.svg', { query: '?raw', import: 'default', eager: true });

const [VW, VH] = brain.viewBox;
const PAD = 6; // matches the padding round each orb's own viewBox
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<figure class="brain" role="img" aria-label={brain.description}>
  <div class="brain__scene" style={`aspect-ratio: ${VW} / ${VH}`}>
    <Fragment set:html={scene} />
    {brain.orbs.map((o, i) => (
      <span
        class={`orb orb--${o.kind}`}
        style={`--i: ${i}; left: ${pct(o.x - o.r - PAD, VW)}; top: ${pct(o.y - o.r - PAD, VH)}; width: ${pct(2 * (o.r + PAD), VW)}`}
      >
        <span class="orb__art" set:html={art[`../assets/brain/orb-${o.id}.svg`]} />
        {!o.sketch && <span class="orb__label">{o.label}</span>}
      </span>
    ))}
  </div>
</figure>

<style>
  .brain {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto var(--space-8);
  }
  @media (max-width: 639px) {
    /* Phones: run to the screen edges so the sketches stay legible. */
    .brain { width: calc(100% + 2 * var(--gutter)); max-width: none; margin-inline: calc(-1 * var(--gutter)); overflow-x: clip; }
  }

  .brain__scene {
    position: relative;
    width: 100%;
    container-type: inline-size;
  }
  .brain__scene :global(.bm-scene-svg) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  /* ---------- Orbs: they bob, and lift a little under the pointer ---------- */
  .orb {
    position: absolute;
    aspect-ratio: 1;
    color: var(--forest-ink);
    animation: bm-bob 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.7s);
  }
  .orb__art { display: block; width: 100%; height: 100%; transition: transform 220ms cubic-bezier(.3, 1.6, .5, 1); }
  .orb__art :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .orb__label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 8%;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(0.5rem, 2cqi, 1.2rem);
    line-height: 0.95;
    text-align: center;
    transition: transform 220ms cubic-bezier(.3, 1.6, .5, 1);
  }
  .orb:hover .orb__art, .orb:hover .orb__label { transform: scale(1.1) rotate(-4deg); }
  .orb--future .orb__label { color: var(--text-secondary); }
  .orb--future :global(.bm-orb-ring) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-spin 16s linear infinite;
  }

  /* ---------- The loop: the line draws from the scribble to the star, which lights up, then it starts again ---------- */
  .brain__scene :global(.bm-tangle) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-wiggle 3s ease-in-out infinite;
  }
  .brain__scene :global(.bm-trail) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: bm-draw 8s ease-in-out infinite;
  }
  .brain__scene :global(.bm-star-end) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-arrive 8s ease-in-out infinite;
  }
  .brain__scene :global(.bm-rays) { animation: bm-rays 2s ease-in-out infinite; }
  .brain__scene :global(.bm-brain-fill) { animation: bm-glow 8s ease-in-out infinite; }

  @keyframes bm-bob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(-1.5deg); }
  }
  @keyframes bm-spin { to { transform: rotate(360deg); } }
  @keyframes bm-wiggle {
    0%, 100% { transform: rotate(-5deg); }
    50% { transform: rotate(5deg); }
  }
  @keyframes bm-draw {
    0%, 5% { stroke-dashoffset: 1; opacity: 1; }
    62%, 90% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes bm-arrive {
    0%, 58% { opacity: 0.25; transform: scale(0.7) rotate(-20deg); }
    66% { opacity: 1; transform: scale(1.15) rotate(6deg); }
    72%, 90% { opacity: 1; transform: scale(1) rotate(0deg); }
    100% { opacity: 0.25; transform: scale(0.7) rotate(-20deg); }
  }
  @keyframes bm-rays {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }
  @keyframes bm-glow {
    0%, 30% { fill-opacity: 0.18; }
    45% { fill-opacity: 0.4; }
    70%, 100% { fill-opacity: 0.18; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brain :global(*), .orb { animation: none !important; transition: none !important; }
    .brain__scene :global(.bm-trail) { stroke-dashoffset: 0; }
  }
</style>
