---
import brain from '../content/brain.json';
// Hand-drawn parts generated by scripts/brain_sketch.py from brain.json; inlined so CSS can animate them.
import scene from '../assets/brain/scene.svg?raw';
import star from '../assets/brain/star.svg?raw';
const art = import.meta.glob<string>('../assets/brain/orb-*.svg', { query: '?raw', import: 'default', eager: true });

const [VW, VH] = brain.viewBox;
const PAD = 6; // matches the padding round each orb's own viewBox
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<section class="brain" aria-labelledby="brain-title">
  <h2 id="brain-title" class="brain__title">{brain.title}</h2>

  <div class="brain__crop">
    <div class="brain__scene" style={`aspect-ratio: ${VW} / ${VH}`}>
      <Fragment set:html={scene} />
      {brain.orbs.map((o, i) => (
        <button
          type="button"
          class={`orb orb--${o.kind}`}
          data-orb={o.id}
          aria-controls="brain-panel"
          style={`--i: ${i}; left: ${pct(o.x - o.r - PAD, VW)}; top: ${pct(o.y - o.r - PAD, VH)}; width: ${pct(2 * (o.r + PAD), VW)}`}
        >
          <span class="orb__art" set:html={art[`../assets/brain/orb-${o.id}.svg`]} />
          <span class={o.sketch ? 'visually-hidden' : 'orb__label'}>{o.label}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="brain__panel" id="brain-panel" aria-live="polite">
    <div class="brain__star" set:html={star} />
    <div class="brain__card brain__card--default" data-card="default">
      <p class="brain__prompt">{brain.prompt}</p>
      <span class="brain__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    {brain.orbs.map((o) => (
      <div class={`brain__card brain__card--${o.kind}`} data-card={o.id} hidden>
        <p class="label brain__tag">{o.tag}</p>
        <h3 class="brain__name">{o.title}</h3>
        {o.text && <p class="brain__text">{o.text}</p>}
        {o.list && <ul class="brain__list">{o.list.map((item) => <li>{item}</li>)}</ul>}
        {o.todo && <p class="brain__text"><span class="todo-tag">To write</span> {o.todo}</p>}
        {o.href && <a class="brain__go" href={o.href}>Go to {o.title} <span aria-hidden="true">↓</span></a>}
      </div>
    ))}
  </div>
</section>

<style>
  .brain {
    width: 100%;
    max-width: 1080px;
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "stage" "title" "panel";
    align-items: start;
    text-align: left;
  }
  @media (min-width: 900px) {
    .brain {
      grid-template-columns: minmax(0, 1fr) 260px;
      grid-template-areas: "stage panel" "title panel";
      column-gap: var(--space-6);
    }
  }

  .brain__title {
    grid-area: title;
    justify-self: center;
    margin-top: var(--space-2);
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    line-height: 1;
    letter-spacing: 0.01em;
    transform: rotate(-2deg);
  }

  /* ---------- The head and its orbs ---------- */
  .brain__crop { grid-area: stage; overflow: visible; }
  .brain__scene {
    position: relative;
    width: 100%;
    container-type: inline-size;
  }
  .brain__scene :global(.bm-scene-svg) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  @media (max-width: 639px) {
    /* Phones: crop to the head (x 230–940 of 1000) so the orbs stay big enough to tap. */
    .brain__crop { overflow: hidden; margin-inline: calc(-1 * var(--gutter)); }
    .brain__scene { width: 140.85%; margin-left: -32.39%; }
  }

  .orb {
    position: absolute;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--forest-ink);
    cursor: pointer;
    animation: bm-bob 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.7s);
  }
  .orb:focus-visible { outline: 3px solid var(--forest-ink); outline-offset: 2px; }
  .orb__art { display: block; width: 100%; height: 100%; transition: transform 220ms cubic-bezier(.3, 1.6, .5, 1); }
  .orb__art :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .orb__label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 8%;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(0.8125rem, 2.3cqi, 1.3rem);
    line-height: 0.95;
    text-align: center;
    pointer-events: none;
    transition: transform 220ms cubic-bezier(.3, 1.6, .5, 1);
  }
  .orb:hover .orb__art, .orb:hover .orb__label,
  .orb.is-active .orb__art, .orb.is-active .orb__label { transform: scale(1.12) rotate(-4deg); }
  .orb.is-active :global(.bm-orb-ring) { stroke-width: 3.4; }
  .orb--future .orb__label { color: var(--text-secondary); }
  .orb--future :global(.bm-orb-ring) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-spin 16s linear infinite;
  }

  /* The questions wriggle; a line carries one into the brain; the folds breathe. */
  .brain__scene :global(.bm-tangle) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bm-wiggle 3s ease-in-out infinite;
  }
  .brain__scene :global(.bm-trail) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: bm-draw 6s ease-in-out infinite;
  }
  .brain__scene :global(.bm-trail-end) { animation: bm-arrive 6s ease-in-out infinite; }
  .brain__scene :global(.bm-brain-fill) { animation: bm-glow 6s ease-in-out infinite; }

  /* ---------- The panel: a star and a card that answers the hovered thought ---------- */
  .brain__panel {
    grid-area: panel;
    position: relative;
    margin-top: var(--space-6);
    padding-top: 48px;
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }
  @media (min-width: 900px) { .brain__panel { margin-top: 8%; } }
  .brain__star {
    position: absolute;
    top: 0;
    right: 12px;
    width: 76px;
    animation: bm-twinkle 4s ease-in-out infinite;
  }
  .brain__star :global(svg) { display: block; width: 100%; overflow: visible; }
  .brain__star :global(.bm-rays) { animation: bm-rays 2s ease-in-out infinite; }

  .brain__card {
    padding: var(--space-5);
    background: var(--surface, #fff);
    border: 1.5px solid var(--forest-ink);
    border-radius: 14px;
    box-shadow: 4px 5px 0 var(--forest-ink);
    transform: rotate(-1deg);
    animation: bm-pop 260ms cubic-bezier(.3, 1.5, .5, 1);
  }
  .brain__card[hidden] { display: none; }
  .brain__prompt {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.1;
  }
  .brain__bars { display: grid; gap: 10px; margin-top: var(--space-4); }
  .brain__bars i {
    display: block;
    height: 18px;
    border: 1.5px solid var(--forest-ink);
    border-radius: 3px 6px 4px 5px;
    opacity: 0.6;
  }
  .brain__bars i:nth-child(2) { width: 86%; }
  .brain__bars i:nth-child(3) { width: 64%; }
  .brain__tag { color: var(--text-secondary); }
  .brain__name {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.15;
  }
  .brain__text { margin-top: var(--space-3); font-size: 0.9375rem; line-height: 1.5; }
  .brain__list { margin: var(--space-3) 0 0; padding-left: 1.1em; font-size: 0.9375rem; line-height: 1.5; }
  .brain__go { display: inline-block; margin-top: var(--space-4); font-weight: 600; }
  .brain__card--future .brain__name { font-family: var(--font-hand); font-size: 2rem; }

  @keyframes bm-bob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(-1.5deg); }
  }
  @keyframes bm-spin { to { transform: rotate(360deg); } }
  @keyframes bm-wiggle {
    0%, 100% { transform: rotate(-5deg); }
    50% { transform: rotate(5deg); }
  }
  @keyframes bm-draw {
    0%, 8% { stroke-dashoffset: 1; opacity: 1; }
    55%, 85% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes bm-arrive {
    0%, 50% { opacity: 0; }
    58%, 85% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes bm-glow {
    0%, 50% { fill-opacity: 0.22; }
    65% { fill-opacity: 0.42; }
    100% { fill-opacity: 0.22; }
  }
  @keyframes bm-twinkle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(8deg) scale(1.06); }
  }
  @keyframes bm-rays {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }
  @keyframes bm-pop {
    from { transform: rotate(-1deg) scale(0.96); opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brain :global(*), .orb, .brain__card, .brain__star { animation: none !important; transition: none !important; }
    .brain__scene :global(.bm-trail) { stroke-dashoffset: 0; }
  }
</style>

<script>
  import '../scripts/pick-my-brain.ts';
</script>
