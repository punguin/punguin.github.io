---
import brain from '../content/brain.json';
// Drawn by scripts/brain_sketch.py. The pencil drawing and each orb are baked to images by scripts/bake_brain.mjs
// (its grain filter is too costly to re-run every frame); CSS only moves the images.
import layout from '../assets/brain/layout.json';
import '../assets/brain/motion.css';

const [VW, VH] = brain.viewBox;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<figure class="brain" role="img" aria-label={brain.description}>
  <div class="brain__scene" style={`aspect-ratio: ${VW} / ${VH}`}>
    <img class="bm-paper" src="/illustrations/brain/paper.webp" width={VW * 2} height={VH * 2} alt="" fetchpriority="high" />
    {layout.map((p) => (
      <div
        class={`bm-orb bm-orb--${p.id}`}
        style={`left: ${pct(p.x, VW)}; top: ${pct(p.y, VH)}; width: ${pct(p.w, VW)}; transform-origin: ${(p.ox * 100).toFixed(1)}% ${(p.oy * 100).toFixed(1)}%`}
      >
        <img src={`/illustrations/brain/piece-${p.id}.webp`} width={p.w * 2} height={p.h * 2} alt="" />
      </div>
    ))}
  </div>
</figure>

<style>
  .brain {
    width: 100%;
    max-width: 640px;
    margin: 0 auto var(--space-8);
  }
  @media (max-width: 639px) {
    /* Phones: run to the screen edges so the doodles stay legible. */
    .brain { width: calc(100% + 2 * var(--gutter)); max-width: none; margin-inline: calc(-1 * var(--gutter)); overflow-x: clip; }
  }

  .brain__scene {
    position: relative;
    width: 100%;
  }
  .bm-paper { position: absolute; inset: 0; width: 100%; height: 100%; }

  .bm-orb { position: absolute; aspect-ratio: 1; will-change: transform; }
  .bm-orb img { display: block; width: 100%; height: auto; }

  @media (prefers-reduced-motion: reduce) {
    /* No drift: the orbs rest where they were drawn. */
    .bm-orb { animation: none !important; }
  }
</style>
