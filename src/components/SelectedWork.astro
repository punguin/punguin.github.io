---
import { render } from 'astro:content';
import DocumentSection from './DocumentSection.astro';
import { getSortedProjects } from '../lib/outline';
import type { CollectionEntry } from 'astro:content';
interface Props { section: CollectionEntry<'sections'> }
const { section } = Astro.props;
const { Content } = await render(section);
const projects = await getSortedProjects();
---
<DocumentSection id={section.data.id} number={section.data.number} label={section.data.navLabel} title={section.data.title} lead={section.data.lead}>
  <div class="prose"><Content /></div>

  <ol class="work-cards" role="list">
    {projects.map((p) => (
      <li class="work-card" style={`--accent: var(--accent-${p.data.accent})`}>
        <a href={`/work/${p.data.id}/`}>
          <span class={`work-card__media${p.data.cover ? '' : ' is-placeholder'}`}>
            {p.data.cover
              ? <img src={p.data.cover} alt={p.data.coverAlt ?? ''} loading="lazy" />
              : <span class="work-card__todo">Image to add</span>}
          </span>
          <span class="work-card__text">
            <span class="work-card__meta">
              <span class="work-card__num">{p.data.number}</span>
              <span class="work-card__domain">{p.data.domain}</span>
            </span>
            <span class="work-card__title">{p.data.title}</span>
            <span class="work-card__summary">{p.data.summary}</span>
            <span class="work-card__go">Read the case study <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</DocumentSection>

<style>
  .work-cards {
    list-style: none;
    display: grid;
    gap: var(--space-6);
    margin: var(--space-7) 0 0;
    padding: 0;
  }
  .work-card a {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--forest-ink);
    text-decoration: none;
    transition: border-color var(--t-hover) ease, box-shadow var(--t-hover) ease, transform var(--t-hover) ease;
  }
  .work-card a:hover {
    border-color: var(--forest-ink);
    box-shadow: var(--shadow-subtle-2);
    transform: translateY(-2px);
  }
  .work-card a:hover .work-card__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }

  .work-card__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--accent);
    overflow: hidden;
  }
  .work-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .work-card__media.is-placeholder {
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(26 51 0 / 0.05) 14px 15px),
      var(--accent);
  }
  .work-card__todo {
    padding: 4px 10px;
    border: 1px dashed var(--forest-ink);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.6);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .work-card__text {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .work-card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .work-card__num {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .work-card__domain { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); }
  .work-card__title { font-family: var(--font-display); font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.125rem); line-height: 1.1; }
  .work-card__summary { font-size: 1.0625rem; line-height: 1.45; color: var(--text-secondary); }
  .work-card__go { margin-top: var(--space-2); font-family: var(--font-mono); font-size: 0.8125rem; }

  /* Wider screens: image on the left, words on the right. */
  @media (min-width: 720px) {
    .work-card a { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
    .work-card__media { aspect-ratio: auto; min-height: 280px; }
    .work-card__text { align-content: center; padding: var(--space-6); }
  }
  @media (prefers-reduced-motion: reduce) { .work-card a, .work-card a:hover { transition: none; transform: none; } }
</style>
