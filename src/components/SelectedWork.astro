---
import { render } from 'astro:content';
import DocumentSection from './DocumentSection.astro';
import { getSortedProjects } from '../lib/outline';
import type { CollectionEntry } from 'astro:content';
interface Props { section: CollectionEntry<'sections'> }
const { section } = Astro.props;
const { Content } = await render(section);
const all = await getSortedProjects();
const projects = all.filter((p) => !p.data.moreWork);
const more = all.filter((p) => p.data.moreWork);
---
<DocumentSection id={section.data.id} number={section.data.number} label={section.data.navLabel} title={section.data.title} lead={section.data.lead}>
  <div class="prose"><Content /></div>

  <ol class="work-cards" role="list">
    {projects.map((p) => (
      <li class="work-card" style={`--card: ${p.data.coverColor ?? `var(--accent-${p.data.accent})`}`}>
        <a href={`/work/${p.data.id}/`}>
          <span class="work-card__text">
            <span class="work-card__kicker">{p.data.title}</span>
            <span class="work-card__title">{p.data.summary}<span class="work-card__arrow" aria-hidden="true"> →</span></span>
            {p.data.cardLine && <span class="work-card__line">{p.data.cardLine}</span>}
            <span class="work-card__tags">
              {p.data.tags
                ? p.data.tags.map((x) => <span class="tag">{x}</span>)
                : <>
                    <span class="tag">{p.data.role.startsWith('[') ? p.data.domain : p.data.role}</span>
                    {p.data.platform.filter((x) => !x.startsWith('[')).slice(0, 2).map((x) => <span class="tag">{x}</span>)}
                  </>}
              {p.body?.includes('data-private') && (
                <span class="tag tag--locked" title="Some details are password protected">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
                  Protected details
                </span>
              )}
            </span>
          </span>
          {p.data.cover && (
            <span class="work-card__media">
              <img src={p.data.cover} alt={p.data.coverAlt ?? ''} width="1600" height="1000" loading="lazy" />
            </span>
          )}
        </a>
      </li>
    ))}
  </ol>

  {more.length > 0 && (
    <div class="more-work">
      <p class="more-work__label">More work</p>
      <ul class="more-work__list" role="list">
        {more.map((p) => (
          <li>
            <a href={`/work/${p.data.id}/`}>{p.data.title}<span aria-hidden="true"> →</span></a>
            {p.data.cardLine && <span class="more-work__line">{p.data.cardLine}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}
</DocumentSection>

<style>
  .work-cards {
    list-style: none;
    display: grid;
    gap: 22px;
    margin: var(--space-7) 0 0;
    padding: 0;
  }
  @media (min-width: 720px) { .work-cards { grid-template-columns: 1fr 1fr; } }

  /* Bright card: the case's colour, its title and tags on top, and the mockup (a transparent image
     whose devices bleed off the right and bottom edges) anchored to the bottom. */
  .work-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    background: var(--card);
    border-radius: 22px;
    transition: box-shadow var(--t-hover) ease;
  }
  .work-card a:hover { box-shadow: 0 0 0 2px var(--ink); }
  .work-card a:hover .work-card__title { text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 1px; }

  .work-card__text { display: grid; align-content: start; gap: 12px; padding: 30px 8% 28px; }
  .work-card__kicker { font-family: var(--font-mono); font-size: 0.8125rem; color: rgba(22, 22, 22, 0.72); }
  .work-card__title { font-family: var(--font-display); font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem); line-height: 1.16; font-weight: 400; max-width: 17em; text-wrap: balance; }
  .work-card__arrow { display: inline-block; font-family: var(--font-body); transition: transform var(--t-hover) ease; }
  .work-card a:hover .work-card__arrow { transform: translateX(4px); }
  .work-card__line { font-size: 0.9375rem; line-height: 1.5; color: rgba(22, 22, 22, 0.78); max-width: 34em; }
  .work-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: 6px; }
  .work-card__tags .tag { background: rgba(255, 255, 255, 0.55); border-color: transparent; }
  .work-card__tags .tag--locked { background: var(--ink); color: var(--paper); }
  .work-card__media { display: block; margin-top: auto; }
  .work-card__media img { display: block; width: 100%; height: auto; }

  /* Smaller projects: a short list under the cards, linking to their pages. */
  .more-work { margin-top: var(--space-6); font-size: 1rem; line-height: 1.5; }
  .more-work__label { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-tertiary); margin: 0 0 var(--space-2); }
  .more-work__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .more-work__list a { font-weight: 600; color: var(--ink); }
  .more-work__line { display: block; color: var(--text-tertiary); }
  @media (min-width: 720px) { .more-work__line { display: inline; } .more-work__line::before { content: ' · '; } }
  @media (prefers-reduced-motion: reduce) { .work-card a, .work-card a:hover { transition: none; transform: none; } }
</style>
