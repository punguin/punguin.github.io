---
import { render } from 'astro:content';
import DocumentSection from './DocumentSection.astro';
import Project from './Project.astro';
import { getSortedProjects } from '../lib/outline';
import type { CollectionEntry } from 'astro:content';
interface Props { section: CollectionEntry<'sections'> }
const { section } = Astro.props;
const { Content } = await render(section);
const projects = await getSortedProjects();
---
<DocumentSection id={section.data.id} number={section.data.number} title={section.data.title} lead={section.data.lead}>
  <div class="prose"><Content /></div>

  <ol class="work-index" role="list">
    {projects.map((p) => (
      <li style={`--accent: var(--accent-${p.data.accent})`}>
        <a href={`#${p.data.id}`}>
          <span class="work-index__num">{p.data.number}</span>
          <span class="work-index__main">
            <span class="work-index__title">{p.data.title}</span>
            <span class="work-index__summary">{p.data.summary}</span>
          </span>
          <span class="work-index__domain">{p.data.domain}</span>
        </a>
      </li>
    ))}
  </ol>

  {projects.map((p) => <Project entry={p} />)}
</DocumentSection>

<style>
  .work-index {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    border-top: 1px solid var(--forest-ink);
  }
  .work-index li { border-bottom: 1px solid var(--border-strong); }
  .work-index a {
    display: grid;
    grid-template-columns: 3.5em 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) var(--space-2);
    margin-inline: calc(-1 * var(--space-2));
    text-decoration: none;
    border-radius: var(--radius-button);
    transition: background-color var(--t-hover) ease;
  }
  .work-index a:hover { background: var(--hover-bg); }
  .work-index a:hover .work-index__title { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .work-index__num {
    justify-self: start;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .work-index__main { display: grid; gap: 2px; min-width: 0; }
  .work-index__title { font-weight: 700; font-size: 1.375rem; line-height: 1.25; }
  .work-index__summary { color: var(--text-secondary); font-size: 1rem; line-height: 1.45; }
  .work-index__domain { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-tertiary); text-align: right; }
  @media (max-width: 599px) {
    .work-index a { grid-template-columns: 3em 1fr; }
    .work-index__domain { grid-column: 2; text-align: left; }
  }
</style>
