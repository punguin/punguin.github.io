---
import { render, type CollectionEntry } from 'astro:content';
// standalone: the case study is the whole page (src/pages/work/[id].astro), so its title is the
// page's h1 and the page's own sheet holds it.
interface Props { entry: CollectionEntry<'projects'>; standalone?: boolean }
const { entry, standalone = false } = Astro.props;
const Title = standalone ? 'h1' : 'h3';
const p = entry.data;
const { Content } = await render(entry);
const isTodo = (v: string) => v.startsWith('[');
const meta: [string, string][] = [
  ['Role', p.role],
  ['Timing', p.timeline],
  ['Platform', p.platform.join(', ')],
  ['Partners', p.partners.join(', ')],
];
---
<article
  class:list={['project', { 'project--page': standalone }]}
  id={p.id}
  data-section={p.id}
  data-accent={p.accent}
  aria-labelledby={`${p.id}-title`}
  style={`--accent: var(--accent-${p.accent})`}
>
  <header class="project__header">
    <p class="eyebrow project__kicker" aria-hidden="true">{p.company} · {p.project}</p>
    <Title class="project__title" id={`${p.id}-title`}>
      <span class="visually-hidden">{p.title}: </span>{p.summary}
    </Title>
  </header>

  <dl class="project__meta">
    <div><dt class="label">Context</dt><dd>{p.context} · {p.domain}</dd></div>
    {meta.map(([k, v]) => (
      <div><dt class="label">{k}</dt><dd class={isTodo(v) ? 'is-todo' : undefined}>{v}</dd></div>
    ))}
  </dl>

  {standalone && p.hero && (
    <figure class="project__hero">
      <img src={p.hero} alt={p.coverAlt ?? ''} width="2400" height="1200" fetchpriority="high" />
    </figure>
  )}

  <div class="prose project__body">
    <Content />
  </div>
</article>

<style>
  .project {
    --case-pad: 0px;
    position: relative;
    margin-top: var(--space-9);
  }
  .project.project--page { margin: 0; padding: 0 0 var(--space-8); }

  .project__header { padding-block: var(--space-8) 0; }
  .project__kicker { margin-bottom: 14px; }
  .project__title {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    max-width: 12em;
  }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 18px;
    margin-block: 44px var(--space-7);
    padding-block: 20px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .project__hero { margin: calc(-1 * var(--space-7) + 8px) 0 var(--space-8); }
  .project__hero img { display: block; width: 100%; height: auto; border-radius: var(--radius-card); }
  .project__meta div { display: grid; gap: var(--space-1); align-content: start; min-width: 0; }
  .project__meta dd { margin: 0; font-size: 0.9375rem; line-height: 1.45; }
  .project__meta dd.is-todo { color: var(--placeholder); font-size: var(--text-small); }

  .project__body > :first-child {
    font-size: clamp(1.1875rem, 1rem + 0.8vw, 1.5625rem);
    line-height: 1.4;
    color: var(--text-secondary);
    max-width: 33em;
  }
  /* Story sections: "#### 00 / Context" is a small label; the line right after it is the
     section's headline. "##### 4.1 …" is a step inside a section, with its own short headline. */
  .project__body :global(h4) {
    margin-top: var(--space-9);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-tertiary);
    max-width: none;
  }
  .project__body :global(h4 + p:not(.todo)) {
    margin-top: var(--space-4);
    max-width: 15em;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .project__body :global(h4 + p:not(.todo) + p:not(.todo)) { font-size: clamp(1.1875rem, 1rem + 0.8vw, 1.5rem); line-height: 1.4; color: var(--text-secondary); }

  .project__body :global(h5) {
    margin-top: var(--space-8);
    margin-bottom: 0;
    max-width: var(--measure);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.4375rem);
    line-height: 1.18;
    letter-spacing: -0.015em;
  }
  .project__body :global(h5 + p) {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .project__body :global(.case-aside) {
    max-width: var(--measure);
    padding: 23px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .project__body :global(.case-aside > * + *) { margin-top: var(--space-2); }
  .project__body :global(.case-aside > :first-child) { margin-top: 0; }
  .project__body :global(p.label) { margin-top: var(--space-7); }
  .project__body :global(p.label)::before { content: ""; display: inline-block; width: 0.55em; height: 0.55em; margin-right: 0.5em; background: var(--violet); vertical-align: 0.05em; }
  .project__body :global(p.label + ul) { margin-top: var(--space-3); }
  .project__body :global(p.label.case-status) { margin-top: var(--space-2); }
  .project__body :global(.case-methods) { font-size: var(--text-small); color: var(--text-secondary); }
  .project__body :global(.case-methods .label) { margin-right: var(--space-2); }

  .project__body :global(table) {
    width: 100%;
    max-width: var(--doc-max);
    margin-top: var(--space-5);
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--text-small);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .project__body :global(th),
  .project__body :global(td) { padding: 12px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .project__body :global(th) { font-size: 0.8125rem; font-weight: 600; color: var(--text-secondary); }
  .project__body :global(tr:last-child td) { border-bottom: 0; }
  @media (max-width: 720px) {
    .project__body :global(table) { display: block; overflow-x: auto; }
    .project__body :global(th),
    .project__body :global(td) { padding: 10px 12px; min-width: 7.5em; }
  }

  .project__body :global(.callout .label) { display: block; margin: 0 0 var(--space-2); }

  /* Impact-first opening (2026-10-19). The lede, then three overview rows (problem, role, what I
     did), then "01 / Impact" as a row of outcomes and "02 / Key decisions" as a numbered list that
     links into "04 / Making it work". Open rows and dividers, no cards: only clickable things get a box. */
  .project__body :global(.case-overview) {
    display: grid;
    max-width: var(--doc-max);
  }
  .project__body :global(.case-overview > div) {
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }
  .project__body :global(.case-overview dt) { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--text-tertiary); padding-top: 0.3em; }
  .project__body :global(.case-overview dd) { margin: 0; max-width: var(--measure); line-height: 1.5; }
  .project__body :global(.case-overview dd ul) { padding-left: 1.1em; font-size: 0.9375rem; }
  .project__body :global(.case-overview dd li + li) { margin-top: var(--space-1); }
  @media (max-width: 600px) {
    .project__body :global(.case-overview > div) { grid-template-columns: 1fr; gap: var(--space-1); }
    .project__body :global(.case-overview dt) { padding-top: 0; }
  }

  .project__body :global(.case-impact) {
    list-style: none;
    padding: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .project__body :global(.case-impact > li) {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-5) var(--space-4);
    border-left: 1px solid var(--line);
  }
  .project__body :global(.case-impact > li:nth-child(2n + 1)) { border-left: 0; padding-left: 0; }
  .project__body :global(.case-impact > li:nth-child(n + 3)) { border-top: 1px solid var(--line); }
  @media (min-width: 960px) {
    .project__body :global(.case-impact) { grid-template-columns: none; grid-auto-columns: minmax(0, 1fr); grid-auto-flow: column; }
    .project__body :global(.case-impact > li:nth-child(n)) { border-left: 1px solid var(--line); border-top: 0; padding-left: var(--space-4); }
    .project__body :global(.case-impact > li:first-child) { border-left: 0; padding-left: 0; }
  }
  .project__body :global(.case-impact__figure) {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .project__body :global(.case-impact__unit) { font-size: 0.55em; margin-left: 0.12em; }
  .project__body :global(.case-impact__figure--text) { white-space: normal; }
  .project__body :global(.case-impact__figure--text) { font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem); line-height: 1.1; }
  .project__body :global(.case-impact__label) { font-weight: 600; font-size: 0.9375rem; line-height: 1.4; }
  .project__body :global(.case-impact__note) { font-size: var(--text-small); line-height: 1.5; color: var(--text-secondary); }
  .project__body :global(.case-impact__kind) { margin-top: auto; padding-top: var(--space-2); font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-tertiary); }
  .project__body :global(.case-impact__kind)::before { content: ""; display: inline-block; width: 0.55em; height: 0.55em; margin-right: 0.5em; background: var(--violet); vertical-align: 0.05em; }
  .project__body :global(.case-impact + p) { font-size: var(--text-small); color: var(--text-secondary); }
  @media (max-width: 420px) {
    .project__body :global(.case-impact > li) { padding-inline: var(--space-3) 0; }
    .project__body :global(.case-impact > li:nth-child(2n + 1)) { padding-right: var(--space-3); }
  }

  .project__body :global(.case-decisions) {
    list-style: none;
    padding: 0;
    max-width: none;
    counter-reset: decision;
    display: grid;
  }
  .project__body :global(.case-decisions > li) {
    margin: 0;
    counter-increment: decision;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--line);
  }
  .project__body :global(.case-decisions > li)::before {
    content: counter(decision, decimal-leading-zero);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }
  .project__body :global(.case-decisions__title) {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    text-wrap: balance;
  }
  .project__body :global(.case-decisions__title a) { text-decoration: none; }
  .project__body :global(.case-decisions__title a:hover) { text-decoration: underline; text-decoration-thickness: 2px; }
  .project__body :global(.case-decisions > li > p:not(.case-decisions__title)) { margin-top: var(--space-2); font-size: 1rem; line-height: 1.55; color: var(--text-secondary); }
  .project__body :global(.case-decisions__more) { font-family: var(--font-mono); font-size: 0.75rem; white-space: nowrap; }
  /* Wide screens: number, decision and why it mattered on one row, so the list stays short. */
  @media (min-width: 760px) {
    .project__body :global(.case-decisions > li) { grid-template-columns: 2.75em minmax(0, 0.85fr) minmax(0, 1.15fr); column-gap: var(--space-5); }
    .project__body :global(.case-decisions > li)::before { margin: 0; padding-top: 0.4em; }
    .project__body :global(.case-decisions > li > p:not(.case-decisions__title)) { margin-top: 0.15em; }
  }

  /* "##### 3.1 People" followed by the perspective's insight: the heading becomes a small label and
     the insight carries the display type, matching the "#### 00 / Section" pattern one level down. */
  .project__body :global(h5:has(+ p.case-insight)) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-tertiary);
  }
  .project__body :global(h5 + p.case-insight) {
    margin-top: var(--space-3);
    max-width: 22em;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    font-weight: var(--weight-display);
    line-height: 1.15;
    color: var(--text-primary);
    text-wrap: balance;
  }
</style>
