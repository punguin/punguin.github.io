---
import { render, type CollectionEntry } from 'astro:content';
// standalone: the case study is the whole page (src/pages/work/[id].astro), so its title is the
// page's h1 and the page's own sheet holds it.
interface Props { entry: CollectionEntry<'projects'>; standalone?: boolean }
const { entry, standalone = false } = Astro.props;
const Title = standalone ? 'h1' : 'h3';
const p = entry.data;
const { Content } = await render(entry);
const isTodo = (v: string) => v.startsWith('[');
// Each case study's tape sits at its own slight angle.
const tilt = [-1.4, 1.1, -0.9, 1.5][(parseInt(p.number.split('.')[1], 10) - 1) % 4];
const meta: [string, string][] = [
  ['Role', p.role],
  ['Timing', p.timeline],
  ['Platform', p.platform.join(', ')],
  ['Partners', p.partners.join(', ')],
];
---
<article
  class:list={['project', { 'project--page': standalone }]}
  id={p.id}
  data-section={p.id}
  data-accent={p.accent}
  aria-labelledby={`${p.id}-title`}
  style={`--accent: var(--accent-${p.accent})`}
>
  <div class="project__sentinel" data-sticky-sentinel aria-hidden="true"></div>
  <div class="project__bar" data-sticky-bar>
    <p class="project__id" aria-hidden="true" style={`--tilt: ${tilt}deg`}>
      <span class="washi" style="--tape: var(--accent)"><span class="project__num">{p.number}</span><span class="project__sep">·</span>{p.title}</span>
    </p>
  </div>

  <header class="project__header">
    <Title class="project__title" id={`${p.id}-title`}>
      <span class="visually-hidden">{p.number} · {p.title}: </span>{p.summary}
    </Title>
    <p class="project__name"><span class="project__name-title">{p.title}</span> <span class="project__name-sub">{p.project}</span></p>
  </header>

  <dl class="project__meta">
    <div><dt class="label">Context</dt><dd>{p.context} · {p.domain}</dd></div>
    {meta.map(([k, v]) => (
      <div><dt class="label">{k}</dt><dd class={isTodo(v) ? 'is-todo' : undefined}>{v}</dd></div>
    ))}
  </dl>

  <div class="prose project__body">
    <Content />
  </div>
</article>

<style>
  /* Each case study is its own sheet of slightly warmer paper. */
  .project {
    --case-pad: var(--space-7);
    --bg: #fffdf8;
    --room: var(--case-pad); /* wide visuals bleed to this sheet's edge */
    position: relative;
    margin-top: var(--space-9);
    padding: var(--space-5) var(--case-pad) var(--space-8);
    background: var(--bg);
    border: 1px solid var(--border-subtle);
  }
  .project + :global(.project) { margin-top: var(--space-10); }
  /* On its own page the page's sheet already is the case sheet. */
  .project.project--page {
    --case-pad: var(--sheet-pad-x, var(--sheet-pad));
    --bg: var(--surface);
    margin: 0;
    padding: 0 0 var(--space-8);
    background: none;
    border: 0;
  }
  @media (max-width: 767px) {
    /* Phones: a tighter inner margin so the text keeps its width; the sheet stays inside the page's
       margin so the two pencil edges don't run side by side. */
    .project { --case-pad: var(--space-4); }
  }

  .project__sentinel { height: 1px; margin-bottom: -1px; }

  /* Identifier bar: the tape stays put at rest and while it is stuck at the top of the screen */
  .project__bar {
    z-index: 10;
    background: var(--bg);
  }
  @media (min-width: 1024px) {
    .project__bar { position: sticky; top: 0; }
    .project__bar.is-stuck { border-bottom: 1px solid var(--border-subtle); }
  }
  .project__id {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-block: var(--space-3);
  }
  .project__id .washi { transform: rotate(var(--tilt)); transform-origin: 0 50%; }
  .project__num { font-variant-numeric: tabular-nums; }
  .project__sep { margin-inline: 0.5em; opacity: 0.55; }
  .is-stuck .project__id { padding-block: var(--space-2); }

  .project__header { margin-top: var(--space-5); }
  .project__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 1.9rem + 2vw, 3.4375rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
    max-width: 13em;
  }
  .project__name {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    align-items: baseline;
    max-width: var(--measure);
  }
  .project__name-title { font-weight: 700; font-size: 1.25rem; }
  .project__name-sub { color: var(--text-secondary); }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-4) var(--space-5);
    margin-block: var(--space-7) var(--space-7);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
  }
  .project__meta div { display: grid; gap: var(--space-1); align-content: start; min-width: 0; }
  .project__meta dd { margin: 0; font-size: 0.9375rem; line-height: 1.45; }
  .project__meta dd.is-todo { color: var(--placeholder); font-size: var(--text-small); }

  .project__body > :first-child {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.4375rem);
    line-height: 1.5;
    max-width: 32em;
  }
  /* Story sections: "#### 00 / Context" is a small label; the line right after it is the
     section's headline. "##### 4.1 …" is a step inside a section, with its own short headline. */
  .project__body :global(h4) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--forest-ink);
  }
  .project__body :global(h4)::before {
    content: "";
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    outline: 1px solid var(--forest-ink);
    outline-offset: -1px;
  }
  .project__body :global(h4 + p:not(.todo)) {
    margin-top: var(--space-3);
    max-width: 17em;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.45rem + 1.2vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  .project__body :global(h4 + p:not(.todo) + p:not(.todo)) { font-size: 1.1875rem; line-height: 1.5; }

  .project__body :global(h5) {
    margin-top: var(--space-8);
    margin-bottom: 0;
    max-width: var(--measure);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
    line-height: 1.25;
  }
  .project__body :global(h5 + p) {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .project__body :global(.case-aside) {
    max-width: var(--measure);
    padding: var(--space-1) 0 var(--space-1) var(--space-5);
    border-left: 3px solid var(--accent);
  }
  .project__body :global(.case-aside > * + *) { margin-top: var(--space-2); }
  .project__body :global(p.label) { margin-top: var(--space-7); color: var(--forest-ink); }
  .project__body :global(p.label + ul) { margin-top: var(--space-3); }
  .project__body :global(.case-methods) { font-size: var(--text-small); color: var(--text-secondary); }
  .project__body :global(.case-methods .label) { margin-right: var(--space-2); }

  /* Key lines sit on the case study's own sticky-note colour. */
  .project__body :global(.callout) { background: var(--accent); }
  .project__body :global(.callout .label) { display: block; margin: 0 0 var(--space-2); color: var(--forest-ink); }
  .project__body :global(.visual__frame strong) { color: var(--forest-ink); }
</style>
