---
import { render, type CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'projects'> }
const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const isTodo = (v: string) => v.startsWith('[');
const meta: [string, string][] = [
  ['Role', p.role],
  ['Timing', p.timeline],
  ['Platform', p.platform.join(', ')],
  ['Partners', p.partners.join(', ')],
];
---
<article
  class="project"
  id={p.id}
  data-section={p.id}
  data-accent={p.accent}
  aria-labelledby={`${p.id}-title`}
  style={`--accent: var(--accent-${p.accent})`}
>
  <div class="project__sentinel" data-sticky-sentinel aria-hidden="true"></div>
  <div class="project__bar" data-sticky-bar>
    <p class="project__id">
      <span class="project__num">{p.number}</span>
      <span class="project__sep" aria-hidden="true">·</span>
      <span class="project__id-expanded">{p.company}</span>
      <span class="project__id-compact" aria-hidden="true">{p.title}</span>
    </p>
  </div>

  <header class="project__header">
    <h3 class="project__title" id={`${p.id}-title`}>
      <span class="visually-hidden">{p.number} · {p.title}: </span>{p.summary}
    </h3>
    <p class="project__name"><span class="project__name-title">{p.title}</span> <span class="project__name-sub">{p.project}</span></p>
  </header>

  <dl class="project__meta">
    <div><dt class="label">Context</dt><dd>{p.context} · {p.domain}</dd></div>
    {meta.map(([k, v]) => (
      <div><dt class="label">{k}</dt><dd class={isTodo(v) ? 'is-todo' : undefined}>{v}</dd></div>
    ))}
  </dl>

  <div class="prose project__body">
    <Content />
  </div>
</article>

<style>
  .project {
    position: relative;
    padding-top: var(--space-10);
  }
  .project + :global(.project) { padding-top: var(--space-11); }
  @media (max-width: 767px) {
    .project { padding-top: var(--space-9); }
    .project + :global(.project) { padding-top: var(--space-10); }
  }

  .project__sentinel { height: 1px; margin-bottom: -1px; }

  /* Identifier bar: the expanded identifier at rest, the compact sticky header while reading */
  .project__bar {
    z-index: 10;
    background: var(--bg);
    border-top: 3px solid var(--accent);
  }
  @media (min-width: 1024px) {
    .project__bar { position: sticky; top: 0; }
    .project__bar.is-stuck { border-bottom: 1px solid var(--border-subtle); }
  }
  .project__id {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: 44px;
    padding-top: var(--space-3);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent);
  }
  .project__num { font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .project__id-compact { display: none; }
  .is-stuck .project__id { text-transform: none; letter-spacing: 0.01em; font-size: var(--text-small); }
  .is-stuck .project__id-expanded { display: none; }
  .is-stuck .project__id-compact { display: inline; color: var(--text-primary); }

  .project__header { margin-top: var(--space-5); }
  .project__title {
    font-size: clamp(2.125rem, 1.5rem + 2.4vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.026em;
    max-width: 12em;
  }
  .project__name {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    align-items: baseline;
    max-width: var(--measure);
  }
  .project__name-title { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; }
  .project__name-sub { color: var(--text-secondary); }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-4) var(--space-5);
    margin-block: var(--space-7) var(--space-7);
    padding-block: var(--space-4);
    border-block: 1px solid var(--border-subtle);
  }
  .project__meta div { display: grid; gap: var(--space-1); align-content: start; min-width: 0; }
  .project__meta dd { margin: 0; font-size: 0.9375rem; line-height: 1.45; }
  .project__meta dd.is-todo { color: var(--placeholder); font-size: var(--text-small); }

  .project__body > :first-child {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.4375rem);
    line-height: 1.5;
    max-width: 32em;
  }
  .project__body :global(a) { text-decoration-color: color-mix(in srgb, var(--accent) 70%, transparent); }
  .project__body :global(h4)::before {
    content: "";
    display: block;
    width: 6px;
    height: 6px;
    margin-bottom: var(--space-3);
    background: var(--accent);
  }
</style>
