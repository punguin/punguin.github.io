---
import SectionHeading from './SectionHeading.astro';
interface Props { id: string; number: string; label: string; title: string; lead?: string; tone?: 'dark' }
const { id, number, label, title, lead, tone } = Astro.props;
---
<section class:list={["doc-section", tone && `doc-section--${tone}`]} id={id} aria-labelledby={`${id}-title`} data-section={id}>
  <SectionHeading id={id} number={number} label={label} title={title} lead={lead} />
  <slot />
</section>

<style>
  .doc-section { padding-block: 72px; }
  @media (max-width: 720px) { .doc-section { padding-block: 52px; } }
  /* Dark panel at the content width, with the same corner radius as the hero and case cards. */
  .doc-section--dark {
    --text-primary: #faf9f6;
    --text-secondary: #cfe0dd;
    --line: #6fa8a1;
    --dark-bg: #0f3532;
    --violet: #4fdccd;
    --eyebrow: #a9c9c4;
    --text-tertiary: #a9c9c4;
    color: var(--text-primary);
    background: var(--dark-bg);
    border-radius: 22px;
    padding-inline: clamp(24px, 5vw, 64px);
    margin-block: var(--space-6);
  }
  :global(.sections) > .doc-section--dark { border-top-color: transparent; }
  :global(.sections) > .doc-section--dark + :global(.doc-section) { border-top-color: transparent; }
</style>
