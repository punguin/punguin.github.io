---
// The sticky bar at the top of every page: name and title (a link home) on the left,
// availability and a Contact button on the right. Section links live in the homepage contents list.
const title = 'Senior Product Designer';
const status = ['Open to work'];
---
<header class="site-header">
  <nav class="site-header__inner" aria-label="Site">
    <a class="site-header__brand" href="/">Pung Brooks<span class="site-header__title">{title}</span></a>
    <div class="site-header__end">
      <p class="site-header__status"><span class="site-header__dot" aria-hidden="true"></span>{status.join(' · ')}</p>
      <a class="site-header__contact" href="/#contact">Contact</a>
    </div>
  </nav>
</header>
