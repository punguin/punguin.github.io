---
// Password gate for case studies marked `locked: true`. It only hides the page: the content is still
// in the HTML, so this keeps casual visitors out, not anyone who reads the source.
// One password unlocks every locked case for the rest of the browser session (sessionStorage), and
// the presenter window inherits it because it is opened from the unlocked page.
interface Props { title: string }
const { title } = Astro.props;
---
<script is:inline>
  // Runs before the page paints, so an unlocked visitor never sees the gate flash.
  try { if (sessionStorage.getItem('case-unlocked') === '1') document.documentElement.classList.add('is-unlocked'); } catch { /* storage blocked: ask every time */ }
</script>

<section class="case-gate" aria-labelledby="case-gate-title">
  <form class="case-gate__card" data-case-gate>
    <svg class="case-gate__icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
    <h2 class="case-gate__title" id="case-gate-title">This case study is password protected</h2>
    <p class="case-gate__lead">Enter the password to read {title}, or <a href="/#contact">get in touch</a> and I’ll send it to you.</p>
    <label class="visually-hidden" for="case-gate-input">Password</label>
    <div class="case-gate__row">
      <input class="case-gate__input" id="case-gate-input" name="password" type="password" autocomplete="current-password" placeholder="Password" required />
      <button class="case-gate__btn" type="submit">Unlock</button>
    </div>
    <p class="case-gate__error" role="alert" aria-live="assertive"></p>
  </form>
</section>

<script>
  // SHA-256 of the password, so the word itself isn't sitting in the page source.
  const HASH = 'c35510cfe595519e6d25903fa4192349a420dcb29d6dc652ddb73ab37b9acfeb';
  const form = document.querySelector<HTMLFormElement>('[data-case-gate]');
  const input = form?.querySelector<HTMLInputElement>('input');
  const error = form?.querySelector<HTMLElement>('.case-gate__error');

  const sha256 = async (text: string) => {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return Array.from(new Uint8Array(buf), (b) => b.toString(16).padStart(2, '0')).join('');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!input || !error) return;
    const ok = (await sha256(input.value.trim().toLowerCase())) === HASH;
    if (!ok) {
      error.textContent = 'That password didn’t work. Try again.';
      input.select();
      return;
    }
    try { sessionStorage.setItem('case-unlocked', '1'); } catch { /* storage blocked: unlocked for this page view only */ }
    document.documentElement.classList.add('is-unlocked');
    window.scrollTo({ top: 0 });
    // A deep link (/work/…/#section) couldn't scroll while the story was hidden; do it now.
    if (location.hash.length > 1) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
  });

  // Already unlocked on load: drop the hidden form so it stays out of the accessibility tree.
  if (document.documentElement.classList.contains('is-unlocked')) input?.closest('.case-gate')?.remove();
</script>

<style is:global>
  /* Every element marked data-gated (the story, the presentation button) stays hidden until unlock. */
  html:not(.is-unlocked) [data-gated] { display: none !important; }
  html.is-unlocked .case-gate { display: none; }
</style>

<style>
  .case-gate {
    width: min(calc(100% - 2 * var(--gutter)), 560px);
    margin: var(--space-9) auto;
  }
  .case-gate__card {
    display: grid;
    gap: var(--space-4);
    padding: clamp(24px, 5vw, 40px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .case-gate__icon { color: var(--ink); }
  .case-gate__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 1.9375rem);
    line-height: 1.15;
    text-wrap: balance;
  }
  .case-gate__lead { margin: 0; color: var(--text-secondary); }
  .case-gate__lead a { color: var(--ink); }
  .case-gate__row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .case-gate__input {
    flex: 1 1 200px;
    min-width: 0;
    padding: 12px 16px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-button);
    background: var(--paper);
    color: var(--ink);
    font: 400 1rem/1.2 var(--font-body);
  }
  .case-gate__input:focus-visible,
  .case-gate__btn:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .case-gate__btn {
    padding: 12px 22px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-button);
    background: var(--ink);
    color: var(--paper);
    font: 600 0.9375rem/1 var(--font-body);
    cursor: pointer;
  }
  .case-gate__btn:hover { background: transparent; color: var(--ink); }
  .case-gate__error { margin: 0; min-height: 1.4em; font-size: 0.875rem; color: #a3271b; }
</style>
