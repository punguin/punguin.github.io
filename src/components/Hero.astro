---
import hero from '../content/hero.json';
// Hand-drawn scene generated by scripts/hero_sketch.py; inlined so CSS can animate its parts.
import scene from '../assets/hero-scene.svg?raw';
// Split the statement so one phrase gets the highlighter wash.
const [before, after] = hero.statementHighlight
  ? hero.statement.split(hero.statementHighlight)
  : [hero.statement, undefined];
---
<header class="hero" id="top">
  <p class="hero__identity">
    <span class="tag"><span aria-hidden="true">✦</span> {hero.identity[0]} · {hero.identity[1]}</span>
  </p>

  <h1 class="hero__statement">
    {before}{after !== undefined && <><mark>{hero.statementHighlight}</mark>{after}</>}
  </h1>
  <p class="hero__supporting">{hero.supporting}</p>
  <p class="hero__context">{hero.context}</p>

  <dl class="hero__facts">
    <div>
      <dt class="label">Practice</dt>
      <dd>{hero.capabilities.join(' · ')}</dd>
    </div>
    <div>
      <dt class="label">Based</dt>
      <dd>{hero.location.join(' · ')}</dd>
    </div>
  </dl>

  <p class="hero__actions">
    <a class="button button--primary" href={hero.primaryAction.href}>{hero.primaryAction.label} <span aria-hidden="true">↓</span></a>
    <a class="button button--outline" href={hero.secondaryAction.href}>{hero.secondaryAction.label}</a>
  </p>

  <div class="hero__scene" set:html={scene} />
</header>

<style>
  .hero {
    min-height: min(82vh, 900px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding-block: var(--space-9);
    scroll-margin-top: 200px;
  }
  @media (max-width: 1023px) {
    .hero { min-height: 0; padding-block: var(--space-8) var(--space-9); }
  }

  .hero__identity { margin-bottom: var(--space-6); }

  .hero__statement {
    font-size: var(--text-hero);
    line-height: 1.02;
    max-width: 11em;
    margin-inline: auto;
  }

  .hero__supporting {
    margin-top: var(--space-6);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.4375rem);
    line-height: 1.4;
    font-weight: 500;
    max-width: 30em;
    margin-inline: auto;
    text-wrap: balance;
  }

  .hero__context {
    margin-top: var(--space-4);
    color: var(--text-secondary);
    max-width: var(--measure);
    margin-inline: auto;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-7);
    margin-inline: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-strong);
    max-width: var(--measure);
  }
  .hero__facts div { display: grid; gap: var(--space-1); }
  .hero__facts dd { margin: 0; font-size: 1rem; font-weight: 500; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-7);
  }

  /* ---------- Hand-drawn scene: play next to the rigor ---------- */
  .hero__scene {
    width: 100%;
    max-width: 960px;
    margin-top: var(--space-8);
  }
  .hero__scene :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  @media (max-width: 639px) {
    /* Phones: let the scene run to the screen edges so the sketches stay legible. */
    .hero__scene { width: calc(100% + 2 * var(--gutter)); max-width: none; margin-inline: calc(-1 * var(--gutter)); }
  }

  /* The line from the tangle draws itself to the clear finish, holds, fades, and starts again. */
  .hero__scene :global(.hs-trail) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hs-draw 9s ease-in-out infinite;
  }
  .hero__scene :global(.hs-end) {
    transform-box: fill-box;
    transform-origin: center;
    animation: hs-arrive 9s ease-in-out infinite;
  }
  /* Each sketch bobs on its sticky note, a beat after the one before. */
  .hero__scene :global(.hs-v) {
    transform-box: fill-box;
    transform-origin: 50% 80%;
    animation: hs-bob 4.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.9s);
  }
  .hero__scene :global(.hs-tangle) { animation-name: hs-wiggle; animation-duration: 3s; }

  @keyframes hs-draw {
    0%, 6% { stroke-dashoffset: 1; opacity: 1; }
    60%, 88% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes hs-arrive {
    0%, 56% { opacity: 0; transform: scale(0.6); }
    64%, 88% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }
  @keyframes hs-bob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-6px) rotate(-1.2deg); }
  }
  @keyframes hs-wiggle {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(6deg); }
  }

  /* No motion requested: show the finished drawing, still. */
  @media (prefers-reduced-motion: reduce) {
    .hero__scene :global(*) { animation: none !important; }
    .hero__scene :global(.hs-trail) { stroke-dashoffset: 0; }
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 12px 24px;
    border-radius: var(--radius-button);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: box-shadow var(--t-hover) ease, background-color var(--t-hover) ease;
  }
  .button--primary {
    background: var(--forest-ink);
    color: var(--cream-paper);
    box-shadow: var(--shadow-subtle);
  }
  .button--primary:hover { box-shadow: var(--shadow-subtle-2); text-decoration: none; }
  .button--outline {
    border: 1px solid var(--forest-ink);
    color: var(--forest-ink);
  }
  .button--outline:hover { background: var(--hover-bg); text-decoration: none; }
</style>
