---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DocumentSection from '../components/DocumentSection.astro';
import SelectedWork from '../components/SelectedWork.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ContactLinks from '../components/ContactLinks.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CaseContents from '../components/CaseContents.astro';
import { getSortedSections } from '../lib/outline';

const sections = await getSortedSections();
const rendered = await Promise.all(sections.map(async (s) => ({ entry: s, ...(await render(s)) })));

const contents = sections.map((s) => ({ id: s.data.id, number: s.data.number, label: s.data.navLabel, children: [] }));

const title = 'Pung Brooks — Product Design & Design Leadership';
const description =
  'Pung Brooks is a product designer and design leader with fifteen years of experience making complex products and systems easier to understand across logistics, ecommerce, healthcare communications, and enterprise software.';
---
<BaseLayout title={title} description={description}>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader />

  <div class="page-shell">
    <main class="document" id="main">
      <Hero />

      <div class="home-layout">
      <CaseContents items={contents} title="Pung Brooks" top={false} />
      <div class="sections">
      {rendered.map(({ entry, Content }) => {
        const d = entry.data;
        if (d.id === 'selected-work') return <SelectedWork section={entry} />;
        return (
          <DocumentSection id={d.id} number={d.number} label={d.navLabel} title={d.title} lead={d.lead} tone={d.id === 'values' ? 'dark' : undefined}>
            <div class={`prose prose--${d.id}`}><Content /></div>
            {d.id === 'experience' && <ExperienceTimeline />}
            {d.id === 'contact' && <ContactLinks />}
          </DocumentSection>
        );
      })}
      </div>
      </div>

      <SiteFooter />
    </main>
  </div>

  <script>
    import "../scripts/reveal.ts";
    import "../scripts/document-nav.ts";
  </script>
</BaseLayout>

<style>
  /* Contents on the left, sections on the right (wide screens only). The page widens a little so the sections keep their room. */
  .home-layout { --toc-top: calc(var(--header-h) + 24px); }
  .home-layout :global(.toc) { display: none; }
  @media (min-width: 1100px) {
    :global(:root) { --doc-max: 1280px; }
    .home-layout { display: grid; grid-template-columns: 180px minmax(0, 1fr); column-gap: var(--toc-gap); }
    .home-layout :global(.toc) { display: block; padding-top: 72px; }
    .home-layout > :global(.sections) { min-width: 0; }
  }
</style>
