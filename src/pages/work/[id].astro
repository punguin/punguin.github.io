---
// One page per case study. The homepage's Selected work section lists them and links here.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import Project from '../../components/Project.astro';
import CaseContents from '../../components/CaseContents.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getSortedProjects } from '../../lib/outline';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((entry, i) => ({
    params: { id: entry.data.id },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, next } = Astro.props;
const p = entry.data;
const { headings } = await render(entry);
const title = `${p.title}: ${p.summary} — Pung Brooks`;
---
<BaseLayout title={title} description={`${p.title}. ${p.summary} ${p.project}.`}>
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <!-- Inset hero panel in the case’s colour: back link, title, and the cover mockup bleeding off the right. -->
    <section class="case-hero" style={`--case-color: ${p.coverColor ?? `var(--accent-${p.accent})`}`}>
      <div class="case-hero__inner">
        <p class="case-top"><a class="case-top__back" href="/#selected-work"><span aria-hidden="true">←</span> All work</a></p>
        <div class="case-hero__text">
          <p class="eyebrow case-hero__kicker" aria-hidden="true">{p.company} · {p.project}</p>
          <h1 class="case-hero__title" id={`${p.id}-title`}><span class="visually-hidden">{p.title}: </span>{p.summary}</h1>
        </div>
      </div>
      {p.cover && <img class="case-hero__media" src={p.cover} alt={p.coverAlt ?? ''} width="1600" height="1000" fetchpriority="high" />}
    </section>

    <div class="page-shell">
      <div class="document">
        <div class="case-layout" id="top">
          <div class="case-layout__body">
            <Project entry={entry} standalone />

            <nav class="case-next" aria-label="Next case study">
              <a href={`/work/${next.data.id}/`}>
                <span class="eyebrow">Next case study · {next.data.title}</span>
                <span class="case-next__summary">{next.data.summary} <span aria-hidden="true">→</span></span>
              </a>
            </nav>
          </div>
          <CaseContents headings={headings} title={p.title} />
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />

  <script>
    import '../../scripts/document-nav.ts';
    import '../../scripts/image-viewer.ts';
  </script>
</BaseLayout>

<style>
  .case-next { max-width: var(--case-measure); margin-inline: auto; }

  /* Same inset panel as the homepage hero: the header bar floats on its top edge. */
  .case-hero {
    position: relative;
    overflow: hidden;
    margin: calc(-1 * (var(--header-h) + var(--bar-top)) + var(--frame)) var(--frame) 0;
    padding-top: calc(var(--header-h) + var(--bar-top) - var(--frame));
    background: var(--case-color);
    border-radius: 22px;
  }
  .case-hero__inner {
    display: flex;
    flex-direction: column;
    width: min(calc(100% - 2 * var(--gutter)), var(--doc-max));
    min-height: clamp(520px, 42vw, 660px);
    margin-inline: auto;
    padding-block: 28px var(--space-8);
  }
  .case-top { margin: 0; font-size: 0.875rem; }
  .case-top__back { color: var(--ink); text-decoration: none; }
  .case-top__back:hover { text-decoration: underline; }
  .case-hero__text { position: relative; z-index: 1; margin-block: auto; max-width: 44%; }
  .case-hero__kicker { margin-bottom: 14px; color: rgba(22, 22, 22, 0.72); }
  .case-hero__title {
    font-size: var(--text-h2);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  /* The cover is a transparent mockup whose devices already bleed off its right and bottom edges. */
  .case-hero__media { position: absolute; right: 0; bottom: 0; width: min(56vw, 980px); height: auto; }
  @media (max-width: 899px) {
    .case-hero__inner { min-height: 0; padding-bottom: var(--space-6); }
    .case-hero__text { max-width: none; margin-block: var(--space-7) 0; }
    .case-hero__media { position: static; display: block; width: 100%; }
  }

  /* Case pages run wider than the homepage so images can be bigger; text keeps its measure.
     The header and footer follow the same width. */
  :global(:root) { --doc-max: 1320px; }
  @media (min-width: 1400px) { :global(:root) { --doc-max: min(1320px, 100vw - 2 * 48px); } }

  /* The story on the left, its contents list on the right (desktop only). */
  .case-layout { --toc-top: calc(var(--bar-top) + var(--header-h) + 24px); }
  .case-layout__body { min-width: 0; }
  .case-layout :global(.toc) { display: none; }
  @media (min-width: 1100px) {
    .case-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--toc-width);
      column-gap: 48px;
    }
    .case-layout :global(.toc) { display: block; padding-top: var(--space-7); }
  }

  .case-next { padding-block: var(--space-4) var(--space-9); }
  .case-next a {
    display: grid;
    gap: var(--space-3);
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    text-decoration: none;
  }
  .case-next a:hover { border-color: var(--ink); }
  .case-next__summary { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 1.9375rem); font-family: var(--font-display); font-weight: 400; line-height: 1.15; }
</style>
