---
// One page per case study. The homepage's Selected work section lists them and links here.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Project from '../../components/Project.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getSortedProjects } from '../../lib/outline';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((entry, i) => ({
    params: { id: entry.data.id },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, next } = Astro.props;
const p = entry.data;
const title = `${p.title}: ${p.summary} — Pung Brooks`;
---
<BaseLayout title={title} description={`${p.title}. ${p.summary} ${p.project}.`}>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="page-shell">
    <main class="document" id="main">
      <header class="case-top" id="top">
        <a class="case-top__home" href="/">Pung Brooks <span class="case-top__sub">Design Practice</span></a>
        <a class="case-top__back" href="/#selected-work"><span aria-hidden="true">←</span> All work</a>
      </header>

      <div class="sheet-wrap">
        <div class="sheet sheet--single">
          <div class="sheet__body">
            <Project entry={entry} standalone />

            <nav class="case-next" aria-label="Next case study" style={`--accent: var(--accent-${next.data.accent})`}>
              <p class="label">Next case study</p>
              <a href={`/work/${next.data.id}/`}>
                <span class="washi" style="--tape: var(--accent)">{next.data.number}<span class="case-next__sep">·</span>{next.data.title}</span>
                <span class="case-next__summary">{next.data.summary} <span aria-hidden="true">→</span></span>
              </a>
            </nav>
          </div>
        </div>
      </div>

      <SiteFooter />
    </main>
  </div>

  <script>
    import '../../scripts/document-nav.ts';
    import '../../scripts/sheet-stack.ts';
  </script>
</BaseLayout>

<style>
  .case-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-7) var(--space-8);
  }
  .case-top__home {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--forest-ink);
    text-decoration: none;
  }
  .case-top__sub { margin-left: 0.4em; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-tertiary); }
  .case-top__back { font-family: var(--font-mono); font-size: 0.875rem; color: var(--forest-ink); }

  .case-next {
    margin-top: var(--space-8);
    padding-block: var(--space-7) var(--space-9);
    border-top: 1px solid var(--forest-ink);
  }
  .case-next a { display: grid; justify-items: start; gap: var(--space-4); margin-top: var(--space-4); text-decoration: none; color: var(--forest-ink); }
  .case-next .washi { transform: rotate(-1.2deg); transform-origin: 0 50%; }
  .case-next__sep { margin-inline: 0.5em; opacity: 0.55; }
  .case-next__summary { font-family: var(--font-display); font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem); line-height: 1.1; }
  .case-next a:hover .case-next__summary { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
</style>
